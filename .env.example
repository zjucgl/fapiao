# ===== 数据库（阿里云 RDS MySQL） =====
DATABASE_HOST=your-rds-instance.mysql.rds.aliyuncs.com
DATABASE_PORT=3306
DATABASE_NAME=fapiao_db
DATABASE_USER=your_db_user
DATABASE_PASSWORD=your_db_password
# Prisma 用的连接串，可由上面字段拼接
DATABASE_URL=mysql://${DATABASE_USER}:${DATABASE_PASSWORD}@${DATABASE_HOST}:${DATABASE_PORT}/${DATABASE_NAME}

# ===== JWT =====
JWT_ACCESS_SECRET=please-change-me-to-a-random-32-byte-string
JWT_REFRESH_SECRET=please-change-me-to-another-random-32-byte-string
JWT_ACCESS_TTL=30m
JWT_REFRESH_TTL=7d

# ===== 阿里云 OSS =====
OSS_REGION=oss-cn-hangzhou
OSS_BUCKET=your-bucket-name
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
# 桶 ACL 必须为 private
OSS_SIGNED_URL_EXPIRES_SEC=300
# 项目所有对象前缀，最终 key 形如 {OSS_KEY_PREFIX}team_{teamId}/{yyyymm}/{invoiceId}/{uuid}.{ext}
OSS_KEY_PREFIX=fapiao/

# ===== 超级管理员 seed（仅首次启动用） =====
SUPER_ADMIN_USERNAME=superadmin
SUPER_ADMIN_INITIAL_PASSWORD=please-change-on-first-login

# ===== 服务端 =====
PORT=3000
NODE_ENV=development
